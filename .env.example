# Copy to .env and set a unique password before running Compose.
# Single-quote values containing $ or # to preserve them in Compose dotenv parsing.
POSTGRES_DB=element29
POSTGRES_USER=element29
POSTGRES_PASSWORD=
# Separate runtime role (provision-db-role), use a different random password, 24+ chars.
APP_DB_USER=element29_app
APP_DB_PASSWORD=
# Host is localhost for a native backend; Compose overrides it to postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ENABLE_API_DOCS=false
ENVIRONMENT=development
COOKIE_SECURE=false
APP_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
