# Copy to .env and set a unique password before running Compose.
# Single-quote values containing $ or # to preserve them in Compose dotenv parsing.
POSTGRES_DB=element29
POSTGRES_USER=element29
POSTGRES_PASSWORD=
# Host is localhost for a native backend; Compose overrides it to postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ENABLE_API_DOCS=false
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
