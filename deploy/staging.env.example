# Isolated staging: different DB passwords, certificates and hostname.
# Copy to /etc/element29/staging.env, owner root, mode 0600.
POSTGRES_DB=element29_staging
POSTGRES_USER=element29_owner
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_DB_USER=element29_runtime
APP_DB_PASSWORD=REPLACE_WITH_ANOTHER_64_HEX_SECRET
APP_ORIGINS=["https://it29-staging.example.internal:8443"]
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
TLS_DIRECTORY=/etc/element29/tls-staging
TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
