# Copy to /etc/element29/production.env, owner root, mode 0600.
# Strict KEY=value, no shell quoting, substitutions, multiline or inline comments.
# Replace both password markers with DIFFERENT secrets (openssl rand -hex 32).
POSTGRES_DB=element29
POSTGRES_USER=element29_owner
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_DB_USER=element29_runtime
APP_DB_PASSWORD=REPLACE_WITH_ANOTHER_64_HEX_SECRET
APP_ORIGINS=["https://it29.example.internal"]
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
TLS_DIRECTORY=/etc/element29/tls-production
TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
