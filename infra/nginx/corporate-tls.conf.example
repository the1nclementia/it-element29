# For the enterprise gateway, NOT enabled by local Compose.
# Replace asset.example.internal and certificate paths with approved PKI values.
server {
    listen 80;
    server_name asset.example.internal;
    return 301 https://asset.example.internal$request_uri;
}
server {
    listen 443 ssl;
    server_name asset.example.internal;
    ssl_certificate /etc/nginx/pki/fullchain.pem;
    ssl_certificate_key /etc/nginx/pki/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 10m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
